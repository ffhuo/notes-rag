# ===== LLM / Embedding（OpenAI 兼容端点）=====
# 可指向 Qwen 或任意 OpenAI 兼容服务
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
# 对话模型
LLM_MODEL=gpt-4o-mini
# 嵌入模型
EMBED_MODEL=text-embedding-3-small

# ===== 数据源 =====
# 你的 Obsidian vault 路径（绝对路径）
VAULT_PATH=/Users/guyikang/personal-lib

# ===== 存储 =====
# 向量库（Chroma）持久化目录
CHROMA_DIR=./data/chroma
# SQLite 数据库文件路径
SQLITE_PATH=./data/rag.db

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
# 受保护接口的 API Key（本地单用户场景用）
API_KEY=change-me-to-a-secret
# 允许的前端跨域来源（逗号分隔），本地开发可用 *
CORS_ORIGINS=*
