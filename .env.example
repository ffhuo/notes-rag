# =============================================================================
# notes-rag 环境变量示例
# 用法：cp .env.example .env 后按需修改（.env 已被 .gitignore / .dockerignore 忽略）
#
# 列表字段（VAULT_SOURCES / INGEST_EXTS / INGEST_EXCLUDE_DIRS）
#   支持两种写法，任选其一：
#     VAULT_SOURCES=local:/a,git:https://b.git        # 逗号分隔（推荐，可读性好）
#     VAULT_SOURCES=["local:/a","git:https://b.git"]  # JSON 数组
#
# 接线状态说明（业务代码目前多为 ... 占位，按 docs/design.md Phase 0→4 手写）：
#   [已接线] 代码已实际读取        [待接线] 字段已声明，等对应模块实现后生效
# =============================================================================

# ===== 应用 =====
# [已接线] 对外暴露的版本号（OpenAPI / /healthz）
VERSION=0.1.0
# [已接线] 调试模式：SQL echo、/docs 开关、uvicorn reload
DEBUG=False

# ===== LLM（对话 / 问答，OpenAI 兼容端点）=====
# [待接线] app/rag/llm_client.py
# 可指向 Qwen / DeepSeek / 本地 vLLM 等任意 OpenAI 兼容服务
LLM_BASE_URL=https://api.openai.com/v1
# 必填：留占位值能启动，但调用会 401
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ===== Embedding（文本向量化，OpenAI 兼容端点）=====
# [待接线] app/rag/embedder.py
# 留空即回退到 LLM 同款端点 / 密钥（多数兼容服务两者共用）；
# 仅当 embedding 用独立服务（如本地 BGE-M3、不同供应商）时才需显式填写。
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
# 注意：更换 embedding 模型后向量维度可能不兼容，必须全量重建索引

# ===== 摄取过滤（多格式 / 文件夹过滤，详见 docs/design.md §16）=====
# [待接线] app/services/ingest_service.py
# 一期仅 md / txt；PDF / Word / Excel 需先装可选依赖：uv add pymupdf python-docx openpyxl
INGEST_EXTS=md,txt
# 排除目录：避免构建产物 / 版本控制 / 应用配置 / 缓存等无关目录灌库
INGEST_EXCLUDE_DIRS=node_modules,.git,.obsidian,.trash,__pycache__,.venv

# ===== 存储 =====
# [待接线] Chroma 向量库持久化目录（app/rag/vectorstore.py）
CHROMA_DIR=./data/chroma
# [已接线] SQLite 数据库文件路径
SQLITE_PATH=./data/rag.db

# ===== 服务 =====
# [已接线] 本地运行 127.0.0.1；Docker / 服务端部署 0.0.0.0（见 docs/design.md §15）
HOST=127.0.0.1
PORT=8000
# [已接线] 受保护接口的 API Key（本地用随机串；公网部署前必须换成强随机，配合 HTTPS）
API_KEY=change-me-to-a-secret
# [已接线] 允许的前端跨域来源（逗号分隔）；本地开发可用 *，远程访问收紧为具体域名
CORS_ORIGINS=*

# ===== 多用户与前端（详见 docs/design.md §17）=====
# [待接线] 是否启用多用户：false=个人单用户（资源归 user_id="default"，用 API Key 鉴权）
#                        true=启用账号密码注册/登录 + JWT（前端 Login 页生效）
ENABLE_MULTIUSER=false
# 多用户模式必填：JWT 签发密钥（openssl rand -hex 32 生成）
JWT_SECRET=
# [已接线] 上传 vault 的解压目录（前端「上传 vault」时落这里）
UPLOAD_DIR=./data/uploads
# [待接线] 是否挂载前端静态页面（Vue SPA 产物 app/static）。false 时只提供 API
UI_ENABLED=true

# ===== 日志 =====
# [已接线] LOG_LEVEL 取值限定：INFO / DEBUG / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
LOG_ERROR_FILE=logs/error.log
