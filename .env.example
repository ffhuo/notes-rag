# =============================================================================
# notes-rag 环境变量示例
# 用法：cp .env.example .env 后按需修改（.env 已被 .gitignore / .dockerignore 忽略）
#
# 列表字段（INGEST_EXTS / INGEST_EXCLUDE_DIRS）
#   支持两种写法，任选其一：
#     INGEST_EXTS=md,txt,docx,pdf          # 逗号分隔（推荐，可读性好）
#     INGEST_EXTS=["md","txt","docx","pdf"]  # JSON 数组
#
# 注意：vault 来源和多模型配置不在 .env 中管理，运行时通过数据库 / API / 前端配置。
#
# 接线状态（按当前代码实测标注，判定依据：app/core/config.py 的字段是否有消费点）：
#   [已接线] 代码已实际读取 settings.<字段>，改这里会生效
#   [待接线] 字段已声明但当前无消费点，改动不会生效（能力未落地，或已改用请求参数）
# =============================================================================

# ===== 应用 =====
# [已接线] 对外暴露的版本号（OpenAPI / /healthz）
VERSION=0.1.0
# [已接线] 调试模式：SQL echo、/docs 开关、uvicorn reload
DEBUG=False

# ===== 摄取过滤（多格式 / 文件夹过滤，详见 docs/design.md §16）=====
# [已接线] app/services/sync_service.py（请求级 filters.exts 可覆盖）
# 已支持 md / txt / docx（Word）/ pdf / xlsx（Excel）；老式 .xls 不支持，.xlsm 可按需加入
INGEST_EXTS=md,txt,docx,pdf,xlsx
# [已接线] 排除目录：避免构建产物 / 版本控制 / 应用配置 / 缓存等无关目录灌库
INGEST_EXCLUDE_DIRS=node_modules,.git,.obsidian,.trash,__pycache__,.venv
# [已接线] 单文件字节上限（超过则跳过）；请求级 filters.max_file_size 可覆盖
MAX_FILE_SIZE=10485760

# ===== 同步与作业（变更管理，见 docs/design.md §5.1.1）=====
# [已接线] app/main.py：定时同步间隔（秒），0 = 关闭；>0 时对全部 vault 依次提交增量作业（如 300 = 每 5 分钟）
INGEST_SYNC_INTERVAL=0
# [待接线] 启动后补一次增量同步（main.py 内有实现建议注释，尚未落地）
INGEST_SYNC_ON_STARTUP=false
# [待接线] 跳过「刚被写入」的文件秒数：避免索引到写了一半的内容（Obsidian 保存 = 写临时文件 + rename）
INGEST_SETTLE_SECONDS=2
# [已接线] app/services/run_service.py：全局同时进行的 ingest/rebuild 作业数上限（一期 1：嵌入是瓶颈）
INGEST_MAX_CONCURRENCY=1
# [待接线] 删除总开关：当前由请求级 prune 参数（POST /vaults/{id}/sync）控制，此处字段无消费点
PRUNE_ENABLED=true
# [已接线] app/services/sync_service.py：删除护栏比例阈值（拟删数 / 已知笔记数 超此值 → 拒绝，需 force=true 确认）
# 调大 = 更信任自动化；调小 = 更保守（宁可漏删也不误删）
PRUNE_RATIO_LIMIT=0.5
# [已接线] app/services/run_service.py：每个 vault 保留的作业记录条数（超限按时间裁剪；不裁运行中的行）
SYNC_RUNS_KEEP=50
# [待接线] 进度落库的最小间隔毫秒（阶段跳变与终态强制写，不受此限）
# 调小 = 进度更实时但写库更频繁；调大 = 写库更省但进度更新更粗
PROGRESS_FLUSH_MS=500
# [已接线] app/services/watcher.py：文件系统监听（一期用轮询快照对比实现，默认关闭）
WATCH_ENABLED=false
# [已接线] app/services/watcher.py：轮询 / 事件静默窗口毫秒（窗口内事件合并为一次作业提交）
WATCH_DEBOUNCE_MS=1000

# ===== 存储 =====
# [已接线] Chroma 向量库持久化目录（app/rag/vectorstore.py 与各 service 的 persist_dir）
CHROMA_DIR=./data/chroma
# [已接线] SQLite 数据库文件路径
SQLITE_PATH=./data/rag.db

# ===== 服务 =====
# [已接线] 本地运行 127.0.0.1；Docker / 服务端部署 0.0.0.0（见 docs/design.md §15）
HOST=127.0.0.1
PORT=8000
# [已接线] 受保护接口的 API Key（本地用随机串；公网部署前必须换成强随机，配合 HTTPS）
API_KEY=change-me-to-a-secret
# [已接线] 允许的前端跨域来源（逗号分隔）；本地开发可用 *，远程访问收紧为具体域名
CORS_ORIGINS=*

# ===== 多用户与前端（详见 docs/design.md §17）=====
# [已接线] 是否启用多用户：false=个人单用户（资源归 user_id="default"，用 API Key 鉴权）
#                        true=启用账号密码注册/登录 + JWT（前端 Login 流程生效）
ENABLE_MULTIUSER=false
# [已接线] 多用户模式必填：JWT 签发密钥（openssl rand -hex 32 生成）
JWT_SECRET=
# [已接线] 上传 vault 的解压目录（前端「上传 vault」时落这里）
UPLOAD_DIR=./data/uploads
# [已接线] 是否挂载前端静态页面（Vue SPA 产物 app/static，见 app/main.py 的静态托管）；false 时只提供 API
UI_ENABLED=true

# ===== 日志 =====
# [已接线] LOG_LEVEL 取值限定：INFO / DEBUG / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
LOG_ERROR_FILE=logs/error.log
